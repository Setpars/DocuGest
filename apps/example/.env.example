# Copiez vers `.env.local` pour le développement local (fichier privé, non versionné)
# cp .env.example .env.local
#
# Sur Vercel / Netlify : définissez les mêmes clés dans les variables d’environnement du tableau de bord.

# ----- Application -----
VITE_APP_TITLE = DocuGest
VITE_APP_API_BASEURL = /
VITE_APP_STORAGE_PREFIX = fa_
VITE_APP_SETTING = true
VITE_APP_DEBUG_TOOL =

# ----- Cabinet (note d’honoraires — optionnel) -----
# VITE_CABINET_NOM =
# VITE_CABINET_ADRESSE =
# VITE_CABINET_CONSEILLERS =
# VITE_CABINET_TELEPHONES =
# VITE_CABINET_VILLE = Likasi
# VITE_CABINET_REF_PREFIX = CAB/C.C.E.A.J.MeK&C./LKS
# VITE_CABINET_SIGNATAIRE =
# VITE_CABINET_SIGNATAIRE_QUALITE =

# ----- Firebase (obligatoire) -----
# Console : https://console.firebase.google.com → Paramètres du projet → Vos applications (Web)
VITE_FIREBASE_API_KEY = votre_api_key
VITE_FIREBASE_AUTH_DOMAIN = votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID = votre-projet-id
VITE_FIREBASE_STORAGE_BUCKET = votre-projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID = 000000000000
VITE_FIREBASE_APP_ID = 1:000000000000:web:xxxxxxxx

# ----- Production (build hébergeur) -----
VITE_BUILD_FAKE = false
VITE_BUILD_SOURCEMAP = false
VITE_BUILD_COMPRESS = gzip,brotli
VITE_BUILD_ARCHIVE =
